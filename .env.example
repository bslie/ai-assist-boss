# Copy this file to `.env`. Defaults match docker-compose.yml (local dev only).
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_assist_boss"
REDIS_URL="redis://localhost:6379"

# Telegram (воркер: `npm run worker`). Без токена воркер работает в сухом режиме с логом.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Вход через Telegram (BotFather → Bot Settings → Login Widget): Client ID и Client Secret.
# Redirect URI в BotFather: <APP_URL>/api/auth/telegram/callback
TELEGRAM_LOGIN_CLIENT_ID=""
TELEGRAM_LOGIN_CLIENT_SECRET=""
# Ключ, из которого выводятся секреты привязки руководителя: `npm run tg:link -- <slug>`.
TELEGRAM_BIND_KEY=""

# LLM (OpenAI-совместимый эндпоинт). Для повтора eval из кэша достаточно LLM_MODEL.
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""
LLM_PROVIDER_NAME="openai-compatible"

# Подключения: ключ шифрования доступов (openssl rand -hex 32) и OAuth-приложение Microsoft 365
CONNECTOR_SECRET=""
# Публичный адрес приложения: ссылки в письмах с поручениями (<APP_URL>/t/<token>), страница аватара для Recall
APP_URL="http://localhost:3000"
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Вход в приложение: подпись сессий (openssl rand -hex 32). Без неё вход отключён.
AUTH_SECRET=""

# Стоимость (SPEC инвариант 8): цены ₽ за 1M токенов и ₽ за час бота Recall. Не заданы → стоимость 0, токены пишутся.
LLM_PRICE_INPUT_RUB_PER_M=""
LLM_PRICE_OUTPUT_RUB_PER_M=""
RECALL_PRICE_RUB_PER_HOUR=""
# Окупаемость: средняя стоимость часа сотрудника, ₽ (с налогами). Профиль может переопределить: savedMinutesConfig.hourRateRub.
STAFF_HOUR_RATE_RUB=""

# Отправка писем датасета в тестовый ящик: `npm run mail:send -- --speed 10`.
# Воркер принимает настоящего отправителя из заголовка X-Dataset-From только от MAIL_DATASET_SENDER.
DATASET_SMTP_HOST=""
DATASET_SMTP_PORT="465"
DATASET_SMTP_USER=""
DATASET_SMTP_PASS=""
DATASET_TARGET_EMAIL=""
MAIL_DATASET_SENDER=""
