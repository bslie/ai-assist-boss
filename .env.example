# Copy this file to `.env`. Defaults match docker-compose.yml (local dev only).
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_assist_boss"
REDIS_URL="redis://localhost:6379"

# Telegram (воркер: `npm run worker`). Без токена воркер работает в сухом режиме с логом.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Ключ, из которого выводятся секреты привязки руководителя: `npm run tg:link -- <slug>`.
TELEGRAM_BIND_KEY=""

# LLM (OpenAI-совместимый эндпоинт). Для повтора eval из кэша достаточно LLM_MODEL.
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""
LLM_PROVIDER_NAME="openai-compatible"

# Подключения: ключ шифрования доступов (openssl rand -hex 32) и OAuth-приложение Microsoft 365
CONNECTOR_SECRET=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
